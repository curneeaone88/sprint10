<odoo>
    <data>
        <!-- Inherit purchase request tree -->
        <record id="purchase_request_tree_view" model="ir.ui.view">
            <field name="model">purchase.request</field>
            <field name="inherit_id" ref="purchase_request.view_purchase_request_tree"/>
            <field name="arch" type="xml">
                <xpath expr='//tree/field[@name="origin"]' position="replace">
                    <field name="origin" invisible="1"/>
                </xpath>
                <xpath expr='//tree/field[@name="origin"]' position="after" >
                    <field name="x_no_so" invisible="1"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit purchase request form -->
         <record id="purchase_request_form" model="ir.ui.view">
            <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <field name="description" position="after">
                    <field name="x_no_so" invisible="1"/> <!-- Uswa-Tambahin field x_no_so -->
                </field>
            </field>
        </record>

        <!-- Inherit search view in Purchase Request -->
        <record id="inherit_purchase_request_search" model="ir.ui.view">
              <field name="name">purchase.request.search</field>
              <field name="model">purchase.request</field>
              <field name="inherit_id" ref="purchase_request.view_purchase_request_search"/>
              <field name="arch" type="xml">
                    <field name="state" position="after">
                        <field name="x_no_so" invisible="1"/>
                    </field>
              </field>
        </record>

        <record id="inherit_purchase_request_tree" model="ir.ui.view">
            <field name="inherit_id" ref="purchase_request.view_purchase_request_form"/>
            <field name="model">purchase.request</field>
            <field name="arch" type="xml">
                <xpath expr='//field[@name="line_ids"]/tree/field[@name="name"]' position="after">
                    <field name="x_pr_prdrepeat"/>
                    <field name="x_pr_ukuran"/>
                    <field name="x_pr_panjang"/>
                    <field name="x_pr_lebar"/>
                    <field name="x_pr_bahan"/>
                    <field name="x_pr_finishing"/>
                    <field name="x_internal_categ"/>
                    <field name="x_no_so"/>
                    <field name="x_quo_purchase_m2" invisible="1"/>
                    <field name="x_quo_purchase_price_pcs" invisible="1"/>
                </xpath>
            </field>
        </record>


        <!--Inherit PR Line Tree-->
        <record id="inherit_purchase_request_line_tree" model="ir.ui.view">
            <field name="inherit_id" ref="purchase_request.purchase_request_line_tree"/>
            <field name="model">purchase.request.line</field>
            <field name="arch" type="xml">
                <xpath expr='//tree/field[@name="supplier_id"]' position="after" >
                    <field name="x_no_so"/>
                </xpath>
            </field>
        </record>

        <!-- Inherit PR form -->
         <record id="inherit_purchase_request_line_form" model="ir.ui.view">
            <field name="inherit_id" ref="purchase_request.purchase_request_line_form"/>
            <field name="model">purchase.request.line</field>
            <field name="arch" type="xml">
                <field name="date_start" position="after">
                    <field name="x_no_so"/> <!-- Uswa-Tambahin field x_no_so -->
                </field>
            </field>
        </record>

        <!-- Inherit search view in Purchase Request Line -->
        <record id="inherit_purchase_request_line_search" model="ir.ui.view">
              <field name="name">purchase.request.line.search</field>
              <field name="model">purchase.request.line</field>
              <field name="inherit_id" ref="purchase_request.purchase_request_line_search"/>
              <field name="arch" type="xml">
                    <field name="procurement_id" position="after">
                        <field name="x_no_so"/>
                    </field>
              </field>
        </record>
    </data>
</odoo>
