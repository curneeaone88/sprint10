<odoo>
    <data>
        <record id="purchase_order_inherit" model="ir.ui.view">
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='date_planned']" position="after">
                    <field name="x_sts_repeat" readonly="1" />
                    <field name="x_ukuran"  readonly="1" />
                    <field name="x_bahan"  readonly="1" />
                    <field name="x_finishing"  readonly="1" />
                    <field name="x_no_so" readonly="1"/>
                </xpath>
                <xpath expr="/form/sheet/notebook/page/field[@name='order_line']/tree/field[@name='price_unit']" position="after">
                    <field name="x_qty_meterpersegi_po" readonly="1" />
                    <field name="x_harga_meterpersegi" />
                </xpath>
            </field>
        </record>

        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                 <!-- Add Button Pending -->
                <xpath expr="//button[@name='button_cancel']" position="before">
                    <button name="action_pending"
                            string="Pending Order"
                            type="object"
                            groups="purchase.group_purchase_manager, purchase_request.group_purchase_request_manager"
                            attrs="{'invisible':[('state','in',['done','pending','cancel'])]}"/>

                    <button name="action_back_to_rfq"
                            string="Continue Order"
                            type="object"
                            groups="purchase.group_purchase_manager, purchase_request.group_purchase_request_manager"
                            states="pending"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>

