<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
<data>

    <!-- CUSTOM: Report terpisah, muncul sebagai tombol sendiri di dropdown Print -->
    <report
        id="report_account_invoice_dp"
        model="account.invoice"
        string="Cetak Invoice DP"
        report_type="qweb-pdf"
        name="lpj_sales.report_invoice_dp"
        file="lpj_sales.report_invoice_dp"
        menu="True"
        paperformat="lpj_sales.paperformat_invoice"
    />

    <template id="report_invoice_dp_document">
        <t t-call="report.html_container">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})" />
            <div class="page" style="font-size:10px">
                <div class="row">
                    <div class="col-xs-6">
                        <img t-if="res_company.logo" t-att-src="'data:image/png;base64,%s' %res_company.logo" style="width: 33%"/>
                    </div>
                    <div class="col-xs-6" style="text-align:right;">
                        <h5 style="color:#272778; font-size=16px"><strong>Print ideas to life</strong></h5>
                    </div>
                </div>
                <br/>

                <div class="row">
                    <div class="col-xs-12">
                        <h5><strong>PELANGGAN</strong></h5>
                    </div>
                    <div class="col-xs-6">
                        <div style="border:1px solid black; padding: 5px">
                            <div class="row">
                                <div class="col-xs-3">NAMA</div>
                                <div class="col-xs-9"><p t-field="o.partner_id.name"/></div>
                            </div>
                            <div class="row">
                                <div class="col-xs-3">ALAMAT</div>
                                <div class="col-xs-9">
                                    <span t-field="o.partner_id.street"/>,<br/>
                                    <span t-field="o.partner_id.street2"/>,<br/>
                                    <span t-field="o.partner_id.city"/>,
                                    <span t-field="o.partner_id.state_id.name"/>,
                                    <span t-field="o.partner_id.zip"/>,<br/>
                                    <span t-field="o.partner_id.country_id.name"/>,
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-3">TELP</div>
                                <div class="col-xs-9"><p t-field="o.partner_id.phone"/></div>
                            </div>
                            <div class="row">
                                <div class="col-xs-3">FAX</div>
                                <div class="col-xs-9"><p t-field="o.partner_id.fax"/></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-6" style="text-alignment:right;">
                        <div style="border:1px solid black; padding:5px">
                            <div class="row">
                                <div class="col-xs-4">FAKTUR #</div>
                                <div class="col-xs-8"><p t-field="o.x_no_faktur"/></div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4">TANGGAL</div>
                                <div class="col-xs-8">
                                    <p><span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %B %Y')"/></p>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4">JATUH TEMPO</div>
                                <div class="col-xs-8"><p t-field="o.x_jatuh_tempo"/></div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4">SO Number</div>
                                <div class="col-xs-8"><p t-field="o.origin"/></div>
                            </div>
                        </div>
                    </div>
                </div>

                <h2>
                    <span t-if="o.type == 'out_invoice' and (o.state == 'open' or o.state == 'paid')">Invoice</span>
                    <span t-if="o.type == 'out_invoice' and o.state == 'proforma2'">PRO-FORMA</span>
                    <span t-if="o.type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                    <span t-if="o.type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                    <span t-if="o.type == 'out_refund'">Refund</span>
                    <span t-if="o.type == 'in_refund'">Vendor Refund</span>
                    <span t-if="o.type == 'in_invoice'">Vendor Bill</span>
                    <span t-field="o.number"/>
                    <span style="background-color:#5bc0de; color:#ffffff; padding:4px 12px; border-radius:6px; font-size:14px; font-weight:bold; margin-left:10px; vertical-align:middle;">(DOWN PAYMENT)</span>
                </h2>

                <div class="row mt32 mb32">
                    <div class="col-xs-2" t-if="o.name">
                        <strong>Description:</strong>
                        <p t-field="o.name"/>
                    </div>
                    <div class="col-xs-2" t-if="o.date_invoice">
                        <strong>Invoice Date:</strong>
                        <p t-field="o.date_invoice"/>
                    </div>
                    <div class="col-xs-2" t-if="o.origin">
                        <strong>Source:</strong>
                        <p t-field="o.origin"/>
                    </div>
                    <div class="col-xs-2" t-if="o.partner_id.ref">
                        <strong>Customer Code:</strong>
                        <p t-field="o.partner_id.ref"/>
                    </div>
                </div>

                <!--
                    CUSTOM: selalu tampilkan SEMUA item asli dari SO
                    (report ini khusus dipanggil untuk invoice DP)
                -->
                <t t-set="x_print_lines" t-value="o.x_get_print_lines()"/>
                <t t-set="display_discount" t-value="any([pl['discount'] for pl in x_print_lines])"/>

                <table class="table table-bordered" style="border: 1px solid black;">
                    <thead>
                        <tr>
                            <th style="border:1px solid black;">No.</th>
                            <th style="border:1px solid black;">Keterangan</th>
                            <th class="text-right" style="border:1px solid black;">QTY</th>
                            <th class="text-right" style="border:1px solid black;">Harga Satuan (Rp.)</th>
                            <th t-if="display_discount" class="text-right" style="border:1px solid black;">Diskon(%)</th>
                            <th class="text-right" style="border:1px solid black;">Pajak</th>
                            <th class="text-right" style="border:1px solid black;">Jumlah (Rp.)</th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-set="i" t-value="1"/>
                        <tr t-foreach="x_print_lines" t-as="pl">
                            <td style="border: 1px solid black;">
                                <span t-esc="i"/>
                                <t t-set="i" t-value="i+1"/>
                            </td>
                            <td style="border: 1px solid black;">
                                <span t-esc="pl['name']"/>
                            </td>
                            <td class="text-right" style="border: 1px solid black;">
                                <span t-esc="pl['qty']"/> <span t-esc="pl['uom']"/>
                            </td>
                            <td class="text-right" style="border: 1px solid black;">
                                <span t-esc="pl['price_unit']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            <td t-if="display_discount" class="text-right" style="border: 1px solid black;">
                                <span t-esc="pl['discount']"/>
                            </td>
                            <td class="text-right" style="border: 1px solid black;">
                                <span t-esc="pl['taxes']"/>
                            </td>
                            <td class="text-right" style="border: 1px solid black;">
                                <span t-esc="pl['subtotal']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <!--
                    CUSTOM: ringkasan disederhanakan, HANYA:
                    Total Sales Order, Down Payment (dipisah dari pajaknya), Total
                    (Subtotal, Bayaran Diterima, Sisa Tagihan, Sisa Belum
                    Ditagih SENGAJA TIDAK ditampilkan di form cetak ini)
                -->
                <t t-set="x_summary" t-value="o.x_get_print_dp_summary()"/>
                <div class="row">
                    <div class="col-xs-4 pull-right">
                        <table class="table table-condensed">
                            <tr class="border-black">
                                <td><strong>Total Sales Order</strong></td>
                                <td class="text-right">
                                    <span t-esc="x_summary['so_total']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                            <tr class="border-black">
                                <td><strong>Down Payment</strong></td>
                                <td class="text-right">
                                    <span t-field="o.amount_untaxed" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                            <t t-foreach="o._get_tax_amount_by_group()" t-as="amount_by_group">
                                <tr class="border-black">
                                    <td>
                                        <strong>Tax </strong><span t-esc="amount_by_group[0] if len(o.tax_line_ids) > 1 else (o.tax_line_ids.tax_id.description or o.tax_line_ids.tax_id.name)"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="amount_by_group[2]"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="border-black">
                                <td><strong>Total</strong></td>
                                <td class="text-right">
                                    <span t-field="o.amount_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="row" t-if="len(o.tax_line_ids) > 0">
                    <div class="col-xs-6">
                        <table class="table table-condensed">
                            <thead>
                                <tr>
                                    <th>Tax</th>
                                    <th class="text-right">Base</th>
                                    <th class="text-right">Tax Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.tax_line_ids" t-as="t">
                                    <td><span t-field="t.tax_id.description"/></td>
                                    <td class="text-right">
                                        <span t-field="t.base" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="t.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xs-8">
                        <h5><strong>DETAIL PEMBAYARAN</strong></h5>
                        <div style="border:1px solid black; padding:5px">
                            <div class="row">
                                <div class="col-xs-4">NAMA BANK:</div>
                                <div class="col-xs-8">Bank Central Asia</div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4">CABANG BANK:</div>
                                <div class="col-xs-8">Surabaya</div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4">NOMOR AKUN BANK:</div>
                                <div class="col-xs-8">4647457788</div>
                            </div>
                            <div class="row">
                                <div class="col-xs-4">ATAS NAMA:</div>
                                <div class="col-xs-8">Sukses Printnusa Indonesia, PT</div>
                            </div>
                        </div>
                        <div style="border:1px solid black; margin-top:10px; padding:5px">
                            <div class="row">
                                <div class="col-xs-12">
                                    TERBILANG
                                    <br/>
                                    <span t-field="o.amount_to_text"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-4" style="text-align: left;">
                        <span style="font-size: 16px">Hormat Kami,</span><br/>
                        <strong style="font-size: 16px">PT. Sukses Printnusa Indonesia</strong>
                        <br/><br/><br/><br/><br/><br/>
                        <strong style="font-size: 16px">FAC</strong>
                    </div>
                </div>

                <div class="oe_structure"/>
                <div class="row" style="margin-top:30px">
                    <div class="col-xs-6"><span style="color:#272778"><strong>Address:</strong></span></div>
                    <div class="col-xs-6;" style="text-align:right;"></div>
                </div>
                <div class="row">
                    <div class="col-xs-6"></div>
                    <div class="col-xs-6;" style="text-align:right;">
                        <span style="color:#272778;">Phone:(+62)31–35936020</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-6">
                        <span style="color:#272778">Jl. Karimun Jawa No. 12-Gubeng, Surabaya, 60281</span>
                    </div>
                    <div class="col-xs-6;" style="text-align:right;">
                        <span style="color:#272778;">Whatsapp: (+62) 811-3319889</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-6">
                        <span style="color:#272778">Jawa Timur, Indonesia</span>
                    </div>
                    <div class="col-xs-6;" style="text-align:right;">
                        <span style="color:#272778;">Whatsapp: (+62) 856-4842-1306</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-6">
                        <span style="color:#272778; text-decoration:underline;"><strong>Email: sales@s-print.co.id</strong></span>
                    </div>
                    <div class="col-xs-6;" style="text-align:right;">
                        <span style="color:#272778; text-decoration:underline;">www.s-print.co.id</span>
                    </div>
                </div>
                <div class="row" style="margin-top:20px">
                    <div class="col-xs-12">
                        <div style="border-bottom: 18px solid #ff4404;"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_invoice_dp">
        <t t-call="report.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="lpj_sales.report_invoice_dp_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

</data>
</odoo>