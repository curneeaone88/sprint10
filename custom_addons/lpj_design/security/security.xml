<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_design" model="ir.module.category">
        <field name="name">Desain</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_design_user" model="res.groups">
        <field name="name">Desain / User</field>
        <field name="category_id" ref="module_category_design"/>
    </record>

    <record id="group_design_manager" model="res.groups">
        <field name="name">Desain / Manager</field>
        <field name="category_id" ref="module_category_design"/>
        <field name="implied_ids" eval="[(4, ref('group_design_user'))]"/>
    </record>

</odoo>
