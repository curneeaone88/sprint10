<odoo>
    <data>

        <record model="ir.actions.act_window" id="products">
            <field name="name">Product</field>
            <field name="res_model">product.template</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
        </record>

         <record model="ir.ui.view" id="config_bentuk_tree_view">
            <field name="name">config_bentuk_tree_view</field>
            <field name="model">x.config.bentuk</field>
            <field name="arch" type="xml">
                <tree string="Bentuk">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="config_bentuk_form_view" model="ir.ui.view">
            <field name="name">config_bentuk_form_view</field>
            <field name="model">x.config.bentuk</field>
            <field name="arch" type="xml">
                <form string="Config Bentuk" create="false" readonly="1">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
                </form>
            </field>
        </record>
        <record id="action_menu_config_bentuk" model="ir.actions.act_window">
            <field name="name">Bentuk</field>
            <field name="res_model">x.config.bentuk</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create New Bentuk
                </p>
            </field>
        </record>

        <record model="ir.ui.view" id="config_diecut_tree_view">
            <field name="name">config_diecut_tree_view</field>
            <field name="model">x.config_diecut</field>
            <field name="arch" type="xml">
                <tree string="Diecut">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="config_diecut_form_view" model="ir.ui.view">
            <field name="name">config_diecut_form_view</field>
            <field name="model">x.config_diecut</field>
            <field name="arch" type="xml">
                <form string="Config Diecut" create="false" readonly="1">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
                </form>
            </field>
        </record>
        <record id="action_menu_config_diecut" model="ir.actions.act_window">
            <field name="name">Diecut</field>
            <field name="res_model">x.config_diecut</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create New Diecut
                </p>
            </field>
        </record>

         <record model="ir.ui.view" id="config_finishing_tree_view">
            <field name="name">config_finishing_tree_view</field>
            <field name="model">x.config_finishing</field>
            <field name="arch" type="xml">
                <tree string="Finishing">
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record id="config_finishing_form_view" model="ir.ui.view">
            <field name="name">config_finishing_form_view</field>
            <field name="model">x.config_finishing</field>
            <field name="arch" type="xml">
                <form string="Config Finishing" create="false" readonly="1">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                    </group>
                </sheet>
                </form>
            </field>
        </record>
        <record id="action_menu_config_finishing" model="ir.actions.act_window">
            <field name="name">Finishing</field>
            <field name="res_model">x.config_finishing</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create New Finishing
                </p>
            </field>
        </record>

        <record model="ir.ui.view" id="config_dataform_tree_view">
            <field name="name">config_dataform_tree_view</field>
            <field name="model">x.cusrequirement</field>
            <field name="arch" type="xml">
                <tree string="Data Form">
                    <field name="name" />
                    <field name="x_product_tmpl"/>
                    <field name="create_date" />
                    <field name="x_bentuk"/>
                    <field name="x_diecut" />
                </tree>
            </field>
        </record>

        <record id="config_dataform_view" model="ir.ui.view">
            <field name="name">config_dataform_view</field>
            <field name="model">x.cusrequirement</field>
            <field name="arch" type="xml">
                <form string="Data Form">
                <sheet>
                    <h1 class="hidden-xs">
                        <field name="name"  readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="x_product"/>
                            <field name="create_uid" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="x_bentuk"/>
                            <field name="x_diecut" />
                            <field name="x_finishing"/>
                             <!--<field name="x_product_tmpl2" invisible="1"/>-->
                        </group>
                        <group>
                            <field name="x_drawing_file" widget="image"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
                </form>
            </field>
        </record>

        <record id="action_config_dataform_view" model="ir.actions.act_window">
            <field name="context">{'default_x_product_tmpl': active_id, 'search_default_x_product_tmpl': active_id}</field>
            <field name="name">Data Form</field>
            <field name="res_model">x.cusrequirement</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create New Data Form
                </p>
            </field>
        </record>


        <record id="action_config_dataform_view_prod" model="ir.actions.act_window">
            <field name="context">{'default_x_product': active_id, 'search_default_x_product': active_id}</field>
            <field name="name">Dataform</field>
            <field name="res_model">x.cusrequirement</field>
            <field name="domain">[]</field> <!-- Force empty -->
            <field name="view_mode">form</field>
            <field name="domain">[]</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">Create New Data Form
                </p>
            </field>
        </record>

    </data>
</odoo>
