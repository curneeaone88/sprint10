<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_settings_form_ok" model="ir.ui.view">
        <field name="name">lpj.production.settings.form.ok</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="lpj_design.view_production_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//footer" position="before">
                <group string="Tanggal Referensi Kirim OK">
                    <div class="text-muted" colspan="2">
                        Tanggal Referensi Kirim = tanggal SO confirm + jumlah hari.
                        Urutan prioritas: (1) Hari Referensi di Master Routing kalau diisi;
                        (2) aturan nominal SO kalau batas nominal dan harinya diisi;
                        (3) aturan jenis OK (New / Repeat). Hanya berlaku untuk OK yang
                        dibuat sesudahnya.
                    </div>
                    <separator string="Berdasarkan nominal SO" colspan="2"/>
                    <field name="x_ok_ref_nominal_limit"/>
                    <field name="x_ok_ref_days_lower"/>
                    <field name="x_ok_ref_days_greater"/>
                    <separator string="Berdasarkan jenis OK" colspan="2"/>
                    <field name="x_ok_ref_days_new"/>
                    <field name="x_ok_ref_days_repeat"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
