<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_item_template_tree" model="ir.ui.view">
        <field name="name">lpj.qc.item.template.tree</field>
        <field name="model">lpj.qc.item.template</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="workcenter_group_id"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_qc_item_template_search" model="ir.ui.view">
        <field name="name">lpj.qc.item.template.search</field>
        <field name="model">lpj.qc.item.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="workcenter_group_id"/>
                <group expand="0" string="Group By">
                    <filter string="Kategori Tahapan" name="group_stage" context="{'group_by':'workcenter_group_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_item_template" model="ir.actions.act_window">
        <field name="name">Master Aktivitas QC</field>
        <field name="res_model">lpj.qc.item.template</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_group_stage': 1}</field>
        <field name="help">Daftar aktivitas pengecekan kualitas per kategori tahapan -- dipakai bersama semua mesin sejenis, mengikuti standar form kertas yang sudah berjalan.</field>
    </record>

</odoo>
