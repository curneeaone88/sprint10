<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== FORM ==================== -->
    <record id="view_production_ok_form" model="ir.ui.view">
        <field name="name">lpj.production.ok.form</field>
        <field name="model">lpj.production.ok</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" states="draft"/>
                    <button name="action_start" type="object" string="Mulai Produksi"
                            states="confirmed"/>
                    <!-- Sengaja TIDAK pakai states="in_progress" saja, karena tombol
                         ini baru boleh kelihatan setelah SEMUA baris Routing Done
                         (all_lines_done), bukan bisa diklik kapan saja selama
                         status In Progress. Lihat all_lines_done di
                         models/production_ok.py. -->
                    <button name="action_request_validation" type="object" string="Ajukan Validasi"
                            class="oe_highlight"
                            attrs="{'invisible': ['|', ('state','!=','in_progress'), ('all_lines_done','=',False)]}"/>
                    <button name="action_validate_done" type="object" string="Validasi &amp; Selesaikan"
                            states="to_validate" class="oe_highlight"
                            groups="lpj_product.group_produksi_supervisor"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            states="draft,confirmed,in_progress"/>
                    <button name="action_set_to_draft" type="object" string="Set to Draft"
                            states="cancel"/>
                    <button name="action_print_perintah_kerja" type="object"
                            string="Cetak Perintah Kerja" icon="fa-print"/>
                    <field name="all_lines_done" invisible="1"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,to_validate,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_qc_checklists" type="object"
                                class="oe_stat_button" icon="fa-check-square-o">
                            <field name="qc_checklist_count" widget="statinfo" string="Checklist QC"/>
                        </button>
                        <button name="action_view_followup_ok" type="object"
                                class="oe_stat_button" icon="fa-share-square-o"
                                attrs="{'invisible': [('followup_ok_count','=',0)]}">
                            <field name="followup_ok_count" widget="statinfo" string="OK Susulan"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3>
                            <field name="status_terakhir" readonly="1"
                                   attrs="{'invisible': [('status_terakhir','=',False)]}"/>
                        </h3>
                        <field name="parent_ok_id" readonly="1"
                               attrs="{'invisible': [('parent_ok_id','=',False)]}"/>
                    </div>
                    <group>
                        <group>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="qty_plan"/>
                            <field name="qty_production"/>
                            <field name="m2_plan" readonly="1"/>
                            <field name="m2_production" readonly="1"/>
                            <field name="total_meter_lari" readonly="1"/>
                            <field name="waste_bahan" readonly="1"/>
                            <field name="waste_percentage" readonly="1"/>
                            <field name="routing_id"/>
                            <field name="routing_display" readonly="1"/>
                            <field name="order_type"/>
                        </group>
                        <group>
                            <field name="responsible_id"/>
                            <field name="plan_ok"/>
                            <field name="x_ref_kirim"/>
                            <field name="x_can_edit_duedate" invisible="1"/>
                            <field name="duedate_kirim"
                                   attrs="{'readonly': [('x_can_edit_duedate','=',False)]}"/>
                            <field name="source" readonly="1"/>
                            <field name="x_folder_cetak" placeholder="Contoh: \\SERVER-CETAK\Produksi\2026\10\Customer\Job"/>
                            <field name="picking_id" readonly="1" attrs="{'invisible': [('picking_id','=',False)]}"/>
                            <field name="material_picking_id" readonly="1" attrs="{'invisible': [('material_picking_id','=',False)]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Routing">
                            <!--
                                mode="tree,kanban": di desktop tampil tabel (tree), di layar
                                kecil (HP/tablet) Odoo otomatis pakai kartu (kanban) di bawah
                                supaya tidak perlu scroll horizontal dan tombolnya besar.
                                Tahapan harus berurutan, tombol Mulai cuma muncul untuk
                                tahap yang gilirannya (can_start).
                            -->
                            <field name="ok_line_ids" mode="tree,kanban">
                                <form>
                                    <group>
                                        <field name="workcenter_group_id" readonly="1"/>
                                        <field name="workcenter_id"/>
                                        <field name="operator_id"/>
                                        <field name="plan_date"/>
                                        <field name="state" invisible="1"/>
                                        <field name="meter_lari" attrs="{'readonly': [('state','=','draft')]}"/>
                                        <field name="qty_pcs" attrs="{'readonly': [('state','=','draft')]}"/>
                                        <field name="date_start" readonly="1"/>
                                        <field name="date_end" readonly="1"/>
                                        <field name="notes"/>
                                    </group>
                                </form>
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="workcenter_group_id"/>
                                    <field name="workcenter_id"/>
                                    <field name="operator_id"/>
                                    <field name="plan_date"/>
                                    <field name="x_can_edit_times" invisible="1"/>
                                    <field name="date_start" attrs="{'readonly': ['|', ('state','=','draft'), ('x_can_edit_times','=',False)]}"/>
                                    <field name="date_end" attrs="{'readonly': ['|', ('state','=','draft'), ('x_can_edit_times','=',False)]}"/>
                                    <field name="meter_lari" attrs="{'readonly': [('state','=','draft')]}"/>
                                    <field name="qty_pcs" attrs="{'readonly': [('state','=','draft')]}"/>
                                    <field name="notes"/>
                                    <field name="state"
                                           decoration-success="state=='done'"
                                           decoration-info="state=='in_progress'"/>
                                    <field name="qc_status"
                                           decoration-success="qc_status=='ok'"
                                           decoration-danger="qc_status=='not_ok'"
                                           decoration-warning="qc_status=='pending'"
                                           decoration-muted="qc_status=='none'"/>
                                    <field name="qc_required" invisible="1"/>
                                    <field name="can_start" invisible="1"/>
                                    <!--
                                        Tombol sengaja dibuat BERGANTIAN muncul (cuma satu
                                        yang kelihatan per saat), bukan tiga-tiganya sekaligus,
                                        supaya urutan kerja operator jelas: Mulai -> (Isi
                                        Checklist, kalau tahap ini ada QC-nya) -> Selesai.

                                        qc_status TIDAK CUKUP sendirian untuk menentukan ini,
                                        karena nilainya baru berubah dari 'none' SETELAH checklist-nya
                                        dibuat, dan checklist baru dibuat lazily saat tombol
                                        'Isi Checklist' diklik (lihat action_open_qc_checklist).
                                        Jadi dipakai field qc_required (dari Master Kategori Proses,
                                        sudah ada sejak baris dibuat) untuk tahu apakah tahap
                                        ini MEMANG punya aktivitas QC atau tidak.

                                        - Mulai: cuma saat masih draft (belum dikerjakan).
                                        - Isi Checklist: cuma saat SUDAH dimulai (in_progress)
                                          DAN tahap ini butuh QC DAN belum sampai hasil akhir
                                          (qc_status belum ok/not_ok).
                                        - Selesai: cuma saat SUDAH dimulai (in_progress) DAN
                                          TIDAK sedang menunggu QC (tahap ini tidak butuh QC
                                          sama sekali, ATAU sudah ada hasil ok/not_ok).
                                    -->
                                    <button name="action_start_line" type="object"
                                            string="Mulai" icon="fa-play"
                                            attrs="{'invisible': ['|', ('state','!=','draft'), ('can_start','=',False)]}"/>
                                    <button name="action_open_qc_checklist" type="object"
                                            string="Isi Checklist" icon="fa-check-square-o"
                                            attrs="{'invisible': ['|', '|', ('state','!=','in_progress'), ('qc_required','=',False), ('qc_status','in',('ok','not_ok'))]}"/>
                                    <button name="action_done_line" type="object"
                                            string="Selesai" icon="fa-check"
                                            attrs="{'invisible': ['|', ('state','!=','in_progress'), '&amp;', ('qc_required','=',True), ('qc_status','not in',('ok','not_ok'))]}"/>
                                </tree>
                                <kanban>
                                    <field name="sequence"/>
                                    <field name="workcenter_group_id"/>
                                    <field name="workcenter_id"/>
                                    <field name="operator_id"/>
                                    <field name="meter_lari"/>
                                    <field name="qty_pcs"/>
                                    <field name="state"/>
                                    <field name="qc_status"/>
                                    <field name="qc_required"/>
                                    <field name="can_start"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click" style="padding: 10px 12px;">
                                                <div style="font-size: 16px; font-weight: 700;">
                                                    <field name="workcenter_group_id"/>
                                                </div>
                                                <div t-if="record.workcenter_id.raw_value" style="font-size: 13px; color: #555;">
                                                    <i class="fa fa-cogs"/> <field name="workcenter_id"/>
                                                </div>
                                                <div t-if="record.operator_id.raw_value" style="font-size: 13px; color: #555;">
                                                    <i class="fa fa-user"/> <field name="operator_id"/>
                                                </div>
                                                <div style="font-size: 13px; color: #555;">
                                                    <span t-if="record.meter_lari.raw_value"><field name="meter_lari"/> m lari</span>
                                                    <span t-if="record.qty_pcs.raw_value"> <field name="qty_pcs"/> pcs</span>
                                                </div>
                                                <div style="margin: 6px 0;">
                                                    <span class="label label-default" t-if="record.state.raw_value == 'draft'"><field name="state"/></span>
                                                    <span class="label label-info" t-if="record.state.raw_value == 'in_progress'"><field name="state"/></span>
                                                    <span class="label label-success" t-if="record.state.raw_value == 'done'"><field name="state"/></span>
                                                    <span class="label label-warning" t-if="record.qc_required.raw_value &amp;&amp; record.qc_status.raw_value != 'ok' &amp;&amp; record.qc_status.raw_value != 'not_ok'">QC belum</span>
                                                    <span class="label label-success" t-if="record.qc_status.raw_value == 'ok'">QC OK</span>
                                                    <span class="label label-danger" t-if="record.qc_status.raw_value == 'not_ok'">QC Not OK</span>
                                                </div>
                                                <div t-if="record.state.raw_value == 'in_progress'" style="margin-bottom: 6px;">
                                                    <button name="action_open_result_form" type="object" class="btn btn-block btn-lg btn-default">
                                                        <i class="fa fa-pencil"/> Input Hasil (Meter Lari / Qty Pcs)
                                                    </button>
                                                </div>
                                                <div t-if="record.state.raw_value == 'draft' &amp;&amp; record.can_start.raw_value">
                                                    <button name="action_start_line" type="object" class="btn btn-block btn-lg btn-primary">
                                                        <i class="fa fa-play"/> Mulai
                                                    </button>
                                                </div>
                                                <div t-if="record.state.raw_value == 'in_progress' &amp;&amp; record.qc_required.raw_value &amp;&amp; record.qc_status.raw_value != 'ok' &amp;&amp; record.qc_status.raw_value != 'not_ok'">
                                                    <button name="action_open_qc_checklist" type="object" class="btn btn-block btn-lg btn-warning">
                                                        <i class="fa fa-check-square-o"/> Isi Checklist QC
                                                    </button>
                                                </div>
                                                <div t-if="record.state.raw_value == 'in_progress' &amp;&amp; !record.qc_required.raw_value">
                                                    <button name="action_done_line" type="object" class="btn btn-block btn-lg btn-success">
                                                        <i class="fa fa-check"/> Selesai
                                                    </button>
                                                </div>
                                                <div t-if="record.state.raw_value == 'in_progress' &amp;&amp; record.qc_required.raw_value &amp;&amp; (record.qc_status.raw_value == 'ok' || record.qc_status.raw_value == 'not_ok')">
                                                    <button name="action_done_line" type="object" class="btn btn-block btn-lg btn-success">
                                                        <i class="fa fa-check"/> Selesai
                                                    </button>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Data Forms">
                            <div class="alert alert-info" role="alert" style="margin-bottom: 10px;">
                                Nilai di bawah otomatis terisi dari Master Product saat OK dibuat.
                                Masih bisa diedit manual di sini kalau job ini memang perlu beda dari master.
                            </div>
                            <group>
                                <group>
                                    <field name="x_length"/>
                                    <field name="x_width"/>
                                    <field name="x_material_id"/>
                                    <field name="x_satuan"/>
                                    <field name="x_type_roll_id"/>
                                </group>
                                <group>
                                    <field name="x_diecut_id"/>
                                    <field name="x_diecut_code"/>
                                    <field name="x_hotprint_code"/>
                                    <field name="x_feature_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                            <group string="Layout (dari Master Product, read-only)">
                                <group>
                                    <field name="x_layout_qty_pcs"/>
                                    <field name="x_layout_width"/>
                                    <field name="x_layout_length"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Form VIEW ONLY OK untuk operator (popup dari kartu Papan Operator). Semua field read-only. -->
    <record id="view_production_ok_form_viewonly" model="ir.ui.view">
        <field name="name">lpj.production.ok.form.viewonly</field>
        <field name="model">lpj.production.ok</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Order Kerja" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="status_terakhir" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="state" readonly="1"/>
                            <field name="order_type" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="qty_plan" readonly="1"/>
                            <field name="qty_production" readonly="1"/>
                            <field name="m2_plan" readonly="1"/>
                            <field name="m2_production" readonly="1"/>
                            <field name="routing_display" readonly="1"/>
                        </group>
                        <group>
                            <field name="responsible_id" readonly="1"/>
                            <field name="plan_ok" readonly="1"/>
                            <field name="duedate_kirim" readonly="1"/>
                            <field name="source" readonly="1"/>
                            <field name="x_folder_cetak" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Routing">
                            <field name="ok_line_ids" readonly="1">
                                <tree create="false" delete="false" edit="false">
                                    <field name="sequence" invisible="1"/>
                                    <field name="workcenter_group_id"/>
                                    <field name="workcenter_id"/>
                                    <field name="operator_id"/>
                                    <field name="plan_date"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="meter_lari"/>
                                    <field name="qty_pcs"/>
                                    <field name="state"/>
                                    <field name="qc_status"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Data Forms">
                            <group>
                                <group>
                                    <field name="x_length" readonly="1"/>
                                    <field name="x_width" readonly="1"/>
                                    <field name="x_material_id" readonly="1"/>
                                    <field name="x_satuan" readonly="1"/>
                                    <field name="x_type_roll_id" readonly="1"/>
                                </group>
                                <group>
                                    <field name="x_diecut_id" readonly="1"/>
                                    <field name="x_diecut_code" readonly="1"/>
                                    <field name="x_hotprint_code" readonly="1"/>
                                    <field name="x_feature_ids" widget="many2many_tags" readonly="1"/>
                                </group>
                            </group>
                            <group string="Layout">
                                <field name="x_layout_qty_pcs" readonly="1"/>
                                <field name="x_layout_width" readonly="1"/>
                                <field name="x_layout_length" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button string="Tutup" special="cancel" class="btn-primary btn-lg"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Form popup input hasil per tahap, dibuka dari tombol Input Hasil di kartu mobile. -->
    <record id="view_production_ok_line_result_form" model="ir.ui.view">
        <field name="name">lpj.production.ok.line.result.form</field>
        <field name="model">lpj.production.ok.line</field>
        <field name="arch" type="xml">
            <form class="o_ok_result_form">
                <field name="state" invisible="1"/>
                <field name="qc_required" invisible="1"/>
                <field name="qc_status" invisible="1"/>
                <div class="o_operator_result">
                <group>
                    <field name="workcenter_group_id" readonly="1"/>
                    <field name="input_mode" invisible="1"/>
                    <field name="ok_id" invisible="1"/>
                    <field name="meter_lari"
                           attrs="{'invisible': [('input_mode','=','qty_pcs')]}"/>
                    <field name="qty_pcs"/>
                    <field name="notes"/>
                </group>
                </div>
                <footer>
                    <button string="Simpan" name="action_save_result" type="object" class="btn-primary btn-lg"/>
                    <button string="Simpan &amp; Selesai" name="action_save_and_done" type="object"
                            class="btn-success btn-lg"
                            attrs="{'invisible': ['|', ('state','!=','in_progress'), '&amp;', ('qc_required','=',True), ('qc_status','not in',['ok','not_ok'])]}"/>
                    <button string="Batal" special="cancel" class="btn-lg"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ==================== TREE ==================== -->
    <record id="view_production_ok_tree" model="ir.ui.view">
        <field name="name">lpj.production.ok.tree</field>
        <field name="model">lpj.production.ok</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state=='cancel'" decoration-success="state=='done'"
                  decoration-warning="state=='to_validate'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="qty_plan"/>
                <field name="routing_display"/>
                <field name="status_terakhir"/>
                <field name="duedate_kirim"/>
                <field name="responsible_id"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- ==================== KANBAN (Papan Kanban status produksi) ==================== -->
    <record id="view_production_ok_kanban" model="ir.ui.view">
        <field name="name">lpj.production.ok.kanban</field>
        <field name="model">lpj.production.ok</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="qty_plan"/>
                <field name="qty_production"/>
                <field name="state"/>
                <field name="order_type"/>
                <field name="duedate_kirim"/>
                <templates>
                    <t t-name="kanban-box">
                        <!-- Biru = Repeat, Kuning = New -->
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click"
                             t-attf-style="border-left: 6px solid #{record.order_type.raw_value == 'repeat' ? '#2f80ed' : '#f2c200'}; background-color: #{record.order_type.raw_value == 'repeat' ? '#e3f0ff' : '#fff6cc'};">
                            <div class="oe_kanban_content">
                                <strong><field name="name"/></strong>
                                <span class="pull-right label"
                                      t-attf-style="color: #fff; background-color: #{record.order_type.raw_value == 'repeat' ? '#2f80ed' : '#d9a400'};">
                                    <field name="order_type"/>
                                </span>
                                <div><field name="partner_id"/></div>
                                <div><field name="product_id"/></div>
                                <div>
                                    <field name="qty_production"/> / <field name="qty_plan"/> pcs
                                </div>
                                <div t-if="record.duedate_kirim.raw_value">
                                    <i class="fa fa-truck"/> Kirim: <field name="duedate_kirim" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== SEARCH ==================== -->
    <record id="view_production_ok_search" model="ir.ui.view">
        <field name="name">lpj.production.ok.search</field>
        <field name="model">lpj.production.ok</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_order_id"/>
                <filter string="Aktif" name="active_ok"
                        domain="[('state','not in',('done','cancel'))]"/>
                <filter string="Menunggu Validasi SPV" name="to_validate_ok" domain="[('state','=','to_validate')]"/>
                <filter string="Selesai" name="done_ok" domain="[('state','=','done')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Responsible" name="group_responsible" context="{'group_by':'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_production_ok" model="ir.actions.act_window">
        <field name="name">Order Kerja</field>
        <field name="res_model">lpj.production.ok</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active_ok': 1}</field>
        <field name="help">Order Kerja (OK) -- dibuat per baris pesanan, berjalan melalui tahap Cetak, Finishing, Packing.</field>
    </record>

</odoo>
