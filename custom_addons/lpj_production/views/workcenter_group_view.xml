<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_workcenter_group_tree" model="ir.ui.view">
        <field name="name">lpj.workcenter.group.tree</field>
        <field name="model">lpj.workcenter.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="workcenter_count"/>
                <field name="qc_item_count"/>
            </tree>
        </field>
    </record>

    <record id="view_workcenter_group_form" model="ir.ui.view">
        <field name="name">lpj.workcenter.group.form</field>
        <field name="model">lpj.workcenter.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_workcenters" type="object"
                                class="oe_stat_button" icon="fa-cogs">
                            <field name="workcenter_count" widget="statinfo" string="Mesin"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="is_material_consumption_stage"/>
                        <field name="x_input_mode"/>
                    </group>
                    <notebook>
                        <page string="Aktivitas QC">
                            <p class="text-muted">
                                Aktivitas ini berlaku untuk SEMUA mesin dengan kategori ini.
                            </p>
                            <field name="qc_item_template_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_workcenter_group" model="ir.actions.act_window">
        <field name="name">Master Tahapan Produksi</field>
        <field name="res_model">lpj.workcenter.group</field>
        <field name="view_mode">tree,form</field>
        <field name="help">Kategori tahapan (Cetak, Slitter, Laminasi, dst.) -- dipasang di Master Mesin sebagai filter saat PPIC memilih mesin di OK, dan jadi tempat mengatur Aktivitas QC yang berlaku untuk semua mesin di kategori itu.</field>
    </record>

</odoo>
