<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_lpj_routing_form" model="ir.ui.view">
        <field name="name">lpj.routing.form</field>
        <field name="model">lpj.routing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="mis. Cetak + Plong + Packing"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <field name="line_ids">
                        <tree editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="workcenter_group_id"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lpj_routing_tree" model="ir.ui.view">
        <field name="name">lpj.routing.tree</field>
        <field name="model">lpj.routing</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="routing_display" string="Tahapan"/>
                <field name="line_count"/>
            </tree>
        </field>
    </record>

    <record id="action_lpj_routing" model="ir.actions.act_window">
        <field name="name">Master Routing</field>
        <field name="res_model">lpj.routing</field>
        <field name="view_mode">tree,form</field>
        <field name="help">Urutan tahapan (kategori) untuk kombinasi produk tertentu. Mesin spesifik dipilih PPIC saat OK dibuat.</field>
    </record>

</odoo>
