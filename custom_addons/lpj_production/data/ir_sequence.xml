<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Format hasil: OK-YYMMDD-XXXXX, mengikuti pola "OK-260524-095" pada mockup -->
        <record id="seq_production_ok" model="ir.sequence">
            <field name="name">Sequence for Order Kerja (OK)</field>
            <field name="code">lpj.production.ok</field>
            <field name="prefix">OK-%(y)s%(month)s%(day)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
