<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Reuse kategori & grup "Production" yang sudah ada di lpj_product
        (lpj_product.group_produksi_user / _supervisor / _manager), supaya
        tidak bikin grup baru yang tumpang tindih.
    -->

    <!-- QC Inspector: grup TERPISAH dari operator produksi (lpj_product.group_produksi_user).
         Cuma grup ini (+ Supervisor & Manager) yang boleh mengisi/mengonfirmasi
         checklist QC (lihat ir.model.access.csv), operator biasa cuma bisa
         membuka/melihat, tidak bisa mengubah hasil pengecekan. -->
    <record id="group_qc_inspector" model="res.groups">
        <field name="name">QC Inspector</field>
        <field name="category_id" ref="lpj_product.module_category_produksi"/>
        <field name="implied_ids" eval="[(4, ref('lpj_product.group_produksi_user_readonly'))]"/>
    </record>

    <record id="production_ok_rule_user" model="ir.rule">
        <field name="name">OK: User hanya lihat OK miliknya / semua (read-only default)</field>
        <field name="model_id" ref="model_lpj_production_ok"/>
        <field name="groups" eval="[(4, ref('lpj_product.group_produksi_user_readonly'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
